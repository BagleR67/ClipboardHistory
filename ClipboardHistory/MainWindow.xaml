<Window x:Class="ClipboardHistory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClipboardHistory"
        mc:Ignorable="d"
        Title="CH Windows" Height="450" Width="800">
    <Grid>
        <Grid Name="mainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Margin="4,8" Text="Поиск:"/>
                <TextBox Name="search" Grid.Column="1" Margin="4,8, 20, 8" Background="LightGray" TextChanged="search_TextChanged"/>
            </Grid>

            <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="mainListBox"  Grid.Row="1" ItemsSource="{Binding}" HorizontalContentAlignment="Stretch" MouseDoubleClick="mainListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding CopiedAt, StringFormat='{}{0:HH:mm}'}" Margin="5"/>
                            <TextBlock Grid.Row="1" Text="{Binding Text}" Margin="5" TextWrapping="Wrap" MaxHeight="65"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Text="Всего элементов: " Margin="4,8"/>
                <TextBlock Name="countElements" Text="{Binding Count}" Margin="4,8"/>
                <Button x:Name="clearButton" Margin="4, 8" Content="Очистить" Click="clearButton_Click"/>
            </StackPanel>
            

        </Grid>
        <Border x:Name="copyNotif" BorderBrush="Black" BorderThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="10" Opacity="0" IsEnabled="False">
            <TextBlock Margin="5" x:Name="CopiedText" Text="Скопировано!" Foreground="Green" FontFamily="#Comic Sans MS" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        
    </Grid>
</Window>
